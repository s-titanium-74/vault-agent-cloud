{
  "$schema": "packages/cloudflare/node_modules/wrangler/config-schema.json",
  "name": "vault-agent-cloud",
  "main": "packages/cloudflare/src/index.ts",
  "tsconfig": "packages/cloudflare/tsconfig.json",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vault-agent-cloud",
      "database_id": "bd26f7cc-c6a8-4186-846b-26792a1762b8",
      "migrations_dir": "packages/cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SOURCE",
      "bucket_name": "vault-agent-cloud","preview_bucket_name": "vault-agent-cloud"
    }
  ],
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "vars": {
    "VAULT_ID": "fdb5ef09-090a-46bd-a601-1b1606a2007a",
    "INGESTION_ENABLED": "true",
    "EXTERNAL_EMBEDDING_CONSENT": "false",
    "EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "EMBEDDING_MODEL_REVISION": "operator-v1",
    "INCLUDE_PATHS": "[\"Notes\",\"images\"]",
    "EXCLUDE_PATHS": "[\"**/secret.md\"]",
    "ALLOWED_ORIGINS": "[]",
    "PROFILE_VALUE_ALLOWLIST": "[\"type\",\"status\"]"
  }
}
